# --- Mobile app (Expo) — copy to `.env` and adjust ---
# Never commit `.env` (gitignored). Anon key is safe in client apps; rotate in Supabase if leaked.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase Edge Functions (remote only) ---
# Set on the linked project: `supabase secrets set KEY=value`
# Do NOT put service role keys or Stripe secrets in the Expo app.

# Core (often auto-injected on hosted Supabase; verify in dashboard)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# AI / media
# OPENAI_API_KEY=sk-...          # process-sketch, analyze-drawing, generate-story, poll-story paths
# FAL_KEY=...                    # process-sketch (video submit), poll-video

# Payments
# STRIPE_SECRET_KEY=sk_live_...  # create-payment, verify-payment, stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional email (send-email)
# EMAIL_SERVICE=resend
# EMAIL_API_KEY=...
